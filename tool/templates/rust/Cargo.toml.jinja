[package]
name = "{{ crate_name }}"
version = "0.0.0"
edition = "2021"
rust-version = "1.88"
{{ publish_line }}
[lib]
path = "src/lib.rs"

# No dependencies. The ABI types the generated code speaks are transcribed in
# `src/abi.rs`; the only thing this crate links is the provider's cdylib, and the
# only symbols it imports from it are the provider's own.
