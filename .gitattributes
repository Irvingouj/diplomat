# Askama drops a template's final "\n" but not a "\r" before it, so a CRLF checkout
# (core.autocrlf=true, the Git for Windows default) leaves a bare CR at the end of
# every rendered file, and the generated Cargo.toml then fails to parse.
tool/templates/rust/** text eol=lf
